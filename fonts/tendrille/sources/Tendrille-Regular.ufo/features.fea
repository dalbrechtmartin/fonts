@FIN_BASE = [a aacute abreve acircumflex adieresis agrave amacron aogonek aring atilde c cacute ccaron ccedilla cdotaccent d dcaron dotlessi e eacute ecaron ecircumflex edieresis edotaccent egrave emacron eogonek h i iacute icircumflex idieresis igrave imacron iogonek k l lacute lcaron m n nacute ncaron ntilde r racute rcaron t tcaron u uacute ucircumflex udieresis ugrave uhungarumlaut umacron uni0137 uni013C uni0146 uni021B uogonek uring z zacute zcaron zdotaccent];
