{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "bump-minor-pre-major": true,
  "packages": {
    "fonts/sorcelle": {
      "component": "sorcelle",
      "package-name": "sorcelle",
      "extra-files": [
        {
          "type": "json",
          "path": "police.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "fonts/griffonne": {
      "component": "griffonne",
      "package-name": "griffonne",
      "extra-files": [
        {
          "type": "json",
          "path": "police.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "fonts/tendrille": {
      "component": "tendrille",
      "package-name": "tendrille",
      "extra-files": [
        {
          "type": "json",
          "path": "police.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
